<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card border-0 shadow-2xl p-4 rounded-4 bg-white border-top border-4 border-gold">
        <div class="text-center mb-4">
          <div class="brand-badge-icon mx-auto mb-2" style="width:50px; height:50px; font-size:1.5rem;">
            <i class="fa-solid fa-hotel"></i>
          </div>
          <h3 class="font-heading fw-bold">Sign In to Portal</h3>
          <p class="text-secondary small">Access customer bookings, room service, or executive admin tools.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show small" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show small" role="alert">
            <i class="fa-solid fa-circle-check me-1"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Demo Credentials Shortcut Banner -->
        <div class="p-3 bg-light rounded-3 mb-4 border border-gold border-dashed">
          <div class="small fw-bold text-gold text-uppercase mb-2"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> Quick Demo Autofill</div>
          <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-dark btn-sm fill-demo-btn" data-email="admin@grandhaven.com" data-pass="admin123">
              <i class="fa-solid fa-user-shield me-1"></i> Admin Demo
            </button>
            <button type="button" class="btn btn-outline-dark btn-sm fill-demo-btn" data-email="customer@grandhaven.com" data-pass="customer123">
              <i class="fa-solid fa-user me-1"></i> Customer Demo
            </button>
          </div>
        </div>

        <form action="/auth/login" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold">Email Address</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
              <input type="email" name="email" id="login-email" class="form-control border-start-0" placeholder="name@grandhaven.com" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold d-flex justify-content-between">
              <span>Password</span>
              <a href="#" class="text-gold text-decoration-none small">Forgot Password?</a>
            </label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
              <input type="password" name="password" id="login-password" class="form-control border-start-0" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-gold w-100 fw-bold py-2 shadow mb-3"><i class="fa-solid fa-right-to-bracket me-2"></i> Sign In to Portal</button>

          <div class="text-center small text-secondary">
            Don't have a guest account? <a href="/auth/register" class="text-gold fw-bold text-decoration-none">Create Account</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.fill-demo-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('login-email').value = btn.dataset.email;
      document.getElementById('login-password').value = btn.dataset.pass;
    });
  });
</script>

<%- include('../partials/footer') %>
