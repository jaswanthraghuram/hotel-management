<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-2xl p-4 rounded-4 bg-white border-top border-4 border-gold">
        <h3 class="font-heading fw-bold mb-3"><i class="fa-solid fa-calendar-check text-gold me-2"></i> Complete Room Reservation</h3>
        <p class="text-secondary small mb-4">Confirm stay dates, select payment option, and receive instant booking invoice.</p>

        <!-- Room Summary -->
        <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h5 class="font-heading fw-bold mb-1">Room <%= room.roomNumber %> (<%= room.roomType ? room.roomType.name : 'Suite' %>)</h5>
            <div class="small text-muted"><%= room.description %></div>
          </div>
          <div class="text-end">
            <div class="fs-4 font-heading fw-bold text-gold">$<%= room.price %></div>
            <div class="small text-muted">per night</div>
          </div>
        </div>

        <form action="/bookings/create" method="POST">
          <input type="hidden" name="roomId" value="<%= room.id %>">

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Check-In Date</label>
              <input type="date" name="checkInDate" class="form-control" value="<%= checkInDate %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold">Check-Out Date</label>
              <input type="date" name="checkOutDate" class="form-control" value="<%= checkOutDate %>" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Select Payment Method</label>
            <div class="row g-3">
              <div class="col-md-4">
                <div class="form-check card p-3 border">
                  <input class="form-check-input" type="radio" name="paymentMethod" value="Credit Card" id="payCC" checked>
                  <label class="form-check-label fw-semibold" for="payCC"><i class="fa-solid fa-credit-card me-1 text-gold"></i> Credit Card</label>
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-check card p-3 border">
                  <input class="form-check-input" type="radio" name="paymentMethod" value="UPI" id="payUPI">
                  <label class="form-check-label fw-semibold" for="payUPI"><i class="fa-solid fa-qrcode me-1 text-gold"></i> UPI / QR Code</label>
                </div>
              </div>
              <div class="col-md-4">
                <div class="form-check card p-3 border">
                  <input class="form-check-input" type="radio" name="paymentMethod" value="Cash" id="payCash">
                  <label class="form-check-label fw-semibold" for="payCash"><i class="fa-solid fa-money-bill-wave me-1 text-gold"></i> Pay Cash</label>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold">Special Requests (Optional)</label>
            <textarea name="specialRequests" class="form-control" rows="3" placeholder="e.g. High floor, extra pillows, late check-in"></textarea>
          </div>

          <div class="p-3 bg-dark text-light rounded-3 mb-4 d-flex justify-content-between align-items-center">
            <div>
              <div class="small text-secondary">Estimated Total (Inc. 12% GST + 5% Service Charge)</div>
              <div class="fw-bold fs-5 text-gold">$<%= (parseFloat(room.price) * 1.17).toFixed(2) %></div>
            </div>
            <button type="submit" class="btn btn-gold px-4 py-2 fw-bold shadow"><i class="fa-solid fa-check-circle me-1"></i> Confirm & Pay</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
