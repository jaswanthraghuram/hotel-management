<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<div class="container-fluid py-4 px-lg-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="font-heading fw-bold mb-0">Room Inventory & Status Control</h2>
      <p class="text-secondary small">Manage rooms, pricing, capacity, amenities, and maintenance states.</p>
    </div>
    <a href="/admin/rooms/add" class="btn btn-gold fw-bold shadow"><i class="fa-solid fa-plus me-1"></i> Add New Room</a>
  </div>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Room #</th>
            <th>Type</th>
            <th>Floor</th>
            <th>Price / Night</th>
            <th>Status</th>
            <th>Bookable</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof rooms !== 'undefined' && rooms.length > 0) { %>
            <% rooms.forEach(room => { %>
              <tr>
                <td class="fw-bold font-heading fs-5 text-gold">Room <%= room.roomNumber %></td>
                <td><span class="badge bg-primary-subtle text-primary border border-primary"><%= room.roomType ? room.roomType.name : 'Suite' %></span></td>
                <td>Floor <%= room.floor %></td>
                <td class="fw-bold">$<%= parseFloat(room.price).toFixed(2) %></td>
                <td>
                  <% let sClass = 'bg-success' %>
                  <% if (room.status === 'Reserved') sClass = 'bg-warning text-dark' %>
                  <% if (room.status === 'Occupied') sClass = 'bg-danger' %>
                  <% if (room.status === 'Cleaning' || room.status === 'Maintenance') sClass = 'bg-secondary' %>
                  <span class="badge <%= sClass %>"><%= room.status %></span>
                </td>
                <td>
                  <% if (room.isBookable) { %>
                    <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check"></i> Enabled</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger"><i class="fa-solid fa-xmark"></i> Disabled</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <a href="/admin/rooms/edit/<%= room.id %>" class="btn btn-outline-dark btn-sm"><i class="fa-solid fa-pen-to-square me-1"></i> Edit</a>
                    <form action="/admin/rooms/delete/<%= room.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete Room <%= room.roomNumber %>?');">
                      <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
