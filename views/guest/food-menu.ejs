<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="bg-dark text-light py-5 border-bottom border-gold">
  <div class="container text-center py-3">
    <h1 class="font-heading display-5 fw-bold"><i class="fa-solid fa-utensils text-gold me-2"></i> In-Room Dining & Gourmet Menu</h1>
    <p class="text-secondary max-w-600 mx-auto">Fresh artisanal meals, handcrafted cocktails, and espresso delivered directly to your luxury room.</p>
  </div>
</div>

<div class="container py-5">
  <div class="row g-4">
    <!-- Main Menu Area -->
    <div class="col-lg-8">
      <!-- Category Pills -->
      <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/food/menu" class="btn <%= !selectedCategoryId ? 'btn-gold fw-bold' : 'btn-outline-secondary' %> rounded-pill px-4">All Items</a>
        <% if (typeof categories !== 'undefined') { %>
          <% categories.forEach(cat => { %>
            <a href="/food/menu?categoryId=<%= cat.id %>" class="btn <%= selectedCategoryId == cat.id ? 'btn-gold fw-bold' : 'btn-outline-secondary' %> rounded-pill px-4">
              <i class="fa-solid <%= cat.icon %> me-1"></i> <%= cat.name %>
            </a>
          <% }) %>
        <% } %>
      </div>

      <!-- Food Item Cards -->
      <div class="row g-4">
        <% if (typeof foodItems !== 'undefined' && foodItems.length > 0) { %>
          <% foodItems.forEach(item => { %>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 card-hover">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h5 class="font-heading fw-bold mb-0"><%= item.name %></h5>
                      <span class="badge bg-gold text-dark font-heading fw-bold">$<%= parseFloat(item.price).toFixed(2) %></span>
                    </div>
                    <p class="text-secondary small mb-3"><%= item.description %></p>
                  </div>

                  <button class="btn btn-outline-dark btn-sm w-100 fw-bold add-to-cart-btn" data-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.price %>">
                    <i class="fa-solid fa-cart-plus me-1 text-gold"></i> Add to Room Service Cart
                  </button>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <p class="text-muted">No menu items found in this category.</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Room Service Cart Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-lg p-4 rounded-4 sticky-top" style="top: 100px;">
        <h4 class="font-heading fw-bold mb-3 d-flex justify-content-between align-items-center">
          <span><i class="fa-solid fa-bell-concierge text-gold me-2"></i> Room Service Cart</span>
          <span class="badge bg-gold text-dark rounded-circle" id="cart-badge"><%= cart.reduce((sum, i) => sum + i.quantity, 0) %></span>
        </h4>

        <div id="cart-items-list" class="mb-3 border-top border-bottom py-3" style="max-height: 280px; overflow-y: auto;">
          <% if (cart.length > 0) { %>
            <% cart.forEach(item => { %>
              <div class="d-flex justify-content-between align-items-center mb-2 small">
                <div>
                  <div class="fw-bold"><%= item.name %></div>
                  <div class="text-muted">$<%= item.price %> x <%= item.quantity %></div>
                </div>
                <div class="fw-bold text-gold">$<%= item.subtotal %></div>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-center text-muted small py-3 mb-0" id="empty-cart-msg">Your room service cart is empty.</p>
          <% } %>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 fs-5 fw-bold">
          <span>Total:</span>
          <span class="text-gold" id="cart-total-display">$<%= cart.reduce((sum, i) => sum + parseFloat(i.subtotal), 0).toFixed(2) %></span>
        </div>

        <!-- Checkout Form Modal Trigger -->
        <button type="button" class="btn btn-gold w-100 fw-bold py-2 shadow" data-bs-toggle="modal" data-bs-target="#checkoutModal" <%= cart.length === 0 ? 'disabled' : '' %> id="checkout-trigger-btn">
          <i class="fa-solid fa-paper-plane me-2"></i> Place Room Service Order
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Checkout Modal -->
<div class="modal fade" id="checkoutModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow-2xl">
      <div class="modal-header bg-dark text-light border-gold">
        <h5 class="modal-title font-heading fw-bold text-gold"><i class="fa-solid fa-hotel me-2"></i> Deliver Room Service</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/food/checkout" method="POST">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-bold">Room Number / Suite</label>
            <input type="text" name="roomNumber" class="form-control" placeholder="e.g. 201" required value="201">
          </div>
          <div class="mb-3">
            <label class="form-label small fw-bold">Special Preparation Instructions</label>
            <textarea name="specialInstructions" class="form-control" rows="3" placeholder="e.g. Extra cutlery, no garlic, deliver at 8:00 AM"></textarea>
          </div>
        </div>
        <div class="modal-footer bg-light border-0">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-gold fw-bold"><i class="fa-solid fa-check me-1"></i> Confirm & Send Order</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
