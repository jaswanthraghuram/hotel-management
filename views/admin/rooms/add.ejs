<%- include('../../partials/header') %>
<%- include('../../partials/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-2xl p-4 rounded-4 bg-white border-top border-4 border-gold">
        <h3 class="font-heading fw-bold mb-3"><i class="fa-solid fa-plus-circle text-gold me-2"></i> Add New Room to Inventory</h3>
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger small"><%= error %></div>
        <% } %>

        <form action="/admin/rooms/add" method="POST" enctype="multipart/form-data">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold">Room Number / Identifier</label>
              <input type="text" name="roomNumber" class="form-control" placeholder="e.g. 601" required>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-bold">Room Category / Type</label>
              <select name="roomTypeId" class="form-select" required>
                <% if (typeof roomTypes !== 'undefined') { %>
                  <% roomTypes.forEach(rt => { %>
                    <option value="<%= rt.id %>"><%= rt.name %> (Capacity: <%= rt.capacity %>, Base: $<%= rt.basePrice %>)</option>
                  <% }) %>
                <% } %>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold">Floor Level</label>
              <input type="number" name="floor" class="form-control" value="1" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Price Per Night ($)</label>
              <input type="number" step="0.01" name="price" class="form-control" placeholder="250.00" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Initial Status</label>
              <select name="status" class="form-select">
                <option value="Available">Available</option>
                <option value="Reserved">Reserved</option>
                <option value="Occupied">Occupied</option>
                <option value="Cleaning">Cleaning</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Out of Service">Out of Service</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Upload Room Showcase Photos (Multiple Allowed)</label>
            <input type="file" name="roomImages" class="form-control" multiple accept="image/*">
            <div class="form-text small">Select up to 5 photos for room gallery (JPG, PNG, WEBP).</div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Amenities Included</label>
            <input type="text" name="amenities" class="form-control" placeholder="WiFi, AC, Jacuzzi, Smart TV, Espresso Bar">
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold">Detailed Room Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Provide a luxury description for the booking gallery..."></textarea>
          </div>

          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" name="isBookable" id="isBookable" checked>
            <label class="form-check-label fw-bold" for="isBookable">Enable Online & Offline Booking Reservations for this Room</label>
          </div>

          <div class="d-flex gap-2">
            <a href="/admin/rooms" class="btn btn-secondary px-4">Cancel</a>
            <button type="submit" class="btn btn-gold fw-bold px-4"><i class="fa-solid fa-check me-1"></i> Create Room Record</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
