<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-5 text-center">
  <div class="row justify-content-center py-5">
    <div class="col-md-6">
      <div class="card border-0 shadow-lg p-5 rounded-4 bg-white">
        <div class="text-gold display-1 mb-3">
          <i class="fa-solid fa-circle-exclamation"></i>
        </div>
        <h1 class="font-heading fw-bold mb-2"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %> Error</h1>
        <h4 class="font-heading text-secondary mb-3"><%= typeof title !== 'undefined' ? title : 'An Error Occurred' %></h4>
        <p class="text-muted small mb-4"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %></p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/" class="btn btn-gold fw-bold px-4"><i class="fa-solid fa-house me-1"></i> Return Home</a>
          <a href="/rooms" class="btn btn-outline-dark px-4">Browse Accommodations</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
